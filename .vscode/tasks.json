{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SCSS: Watch whitening LP",
      "type": "npm",
      "script": "watch:whitening-lp",
      "isBackground": true,
      "problemMatcher": {
        "owner": "scss-watch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting 'watch:whitening-lp'\\.\\.\\.",
          "endsPattern": "Starting 'watchWhiteningLp'\\.\\.\\."
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}